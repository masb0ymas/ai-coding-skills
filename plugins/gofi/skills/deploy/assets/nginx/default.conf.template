# SPA server: static files + reverse proxy to the API on the same origin.
# ${API_UPSTREAM} is filled from the environment when the container starts.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Larger than nginx's 1m default so API uploads are not cut here first.
    client_max_body_size 10m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API and Authula (/v1/auth). The API trusts X-Forwarded-For only from
    # TRUSTED_PROXIES, so set that to this container's network (rate limits
    # would otherwise count every user as this proxy).
    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 35s;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
    }

    # Content-hashed bundles: safe to cache for a year; a miss is a real 404.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Everything else: the file if it exists, otherwise the app shell for the
    # client-side router. The shell is never cached, so a deploy is picked up
    # on the next navigation.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
